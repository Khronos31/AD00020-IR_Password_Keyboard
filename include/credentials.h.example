/*
 * Local-only credential configuration.
 *
 * Copy this file to credentials.h and replace the placeholders locally:
 *
 *   cp include/credentials.h.example include/credentials.h
 *
 * credentials.h is ignored by git. Do not remove the include guard or add
 * real credentials to this example file.
 */
#ifndef AD00020_CREDENTIALS_H
#define AD00020_CREDENTIALS_H

#define AD00020_PASSWORD_WINDOWS "REPLACE_ME"
#define AD00020_PASSWORD_WSL     "REPLACE_ME"
#define AD00020_PASSWORD_MACOS   "REPLACE_ME"
#define AD00020_PASSWORD_LINUX   "REPLACE_ME"

/* Password-button slots. Slots 05-12 are reserved for future additions. */
#define AD00020_PASSWORD_SLOT_COUNT 4
#define AD00020_PASSWORD_SLOT_01 AD00020_PASSWORD_WINDOWS
#define AD00020_PASSWORD_SLOT_02 AD00020_PASSWORD_WSL
#define AD00020_PASSWORD_SLOT_03 AD00020_PASSWORD_MACOS
#define AD00020_PASSWORD_SLOT_04 AD00020_PASSWORD_LINUX

#endif /* AD00020_CREDENTIALS_H */
